{
  "name": "clarity",
  "version": "1.12.0",
  "description": "Clarity — unified suite (Manager + Installer + Couch in one AppImage)",
  "main": "main.js",
  "desktopName": "clarity.desktop",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "fetch-bin": "node scripts/fetch-binaries.mjs",
    "postinstall": "node scripts/fetch-binaries.mjs && electron-builder install-app-deps",
    "start": "electron .",
    "start:couch": "electron . --couch",
    "pack": "electron-builder --dir",
    "predist": "node scripts/fetch-binaries.mjs",
    "dist": "electron-builder --linux AppImage",
    "postdist": "node scripts/deploy-appimage.mjs",
    "dist:mac": "electron-builder --mac"
  },
  "author": "J.R.A.",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.9.0",
    "gridstack": "^10.3.1",
    "howlongtobeat": "^1.8.0",
    "music-metadata": "^7.13.4"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "io.github.fromchaoscomesclarity.clarity",
    "productName": "Clarity Game Manager",
    "linux": {
      "target": "AppImage",
      "icon": "apps/manager/assets/icons/Clarity.svg",
      "category": "Game",
      "executableName": "clarity",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Clarity",
          "StartupWMClass": "clarity"
        }
      },
      "extraResources": [
        {
          "from": "assets/bin/linux",
          "to": "assets/bin/linux",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "Clarity.AppImage"
    },
    "files": [
      "main.js",
      "packages/**/*",
      "!**/assets/bin/**",
      "apps/manager/**/*",
      "apps/installer/**/*",
      "apps/couch/**/*",
      "!apps/couch/assets/wallpapers/**",
      "!**/GameManagerConfig/**",
      "!**/InstallerConfig/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "apps/manager/assets/icons/Clarity.icns",
      "artifactName": "Clarity-${arch}.${ext}",
      "identity": null,
      "extraResources": [
        {
          "from": "assets/bin/darwin-arm64",
          "to": "assets/bin/darwin-arm64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Clarity.dmg"
    }
  }
}
